{
  "name": "@walioffice/dsh-office-bundle",
  "version": "0.1.0",
  "type": "module",
  "description": "Bundle package that loads all WaLiOffice DSH plugins at once",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/index.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@walioffice/dsh-office": "workspace:*",
    "@walioffice/dsh-tool-ppt": "workspace:*",
    "@walioffice/dsh-tool-doc": "workspace:*",
    "@walioffice/dsh-tool-sheet": "workspace:*",
    "@walioffice/dsh-tool-chart": "workspace:*",
    "@walioffice/dsh-tool-drawio": "workspace:*",
    "@walioffice/dsh-tool-image": "workspace:*",
    "@walioffice/dsh-tool-video": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}