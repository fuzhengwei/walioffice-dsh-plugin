{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src"],
  "references": [
    { "path": "../walioffice-dsh-office" },
    { "path": "../walioffice-dsh-tool-ppt" },
    { "path": "../walioffice-dsh-tool-doc" },
    { "path": "../walioffice-dsh-tool-sheet" },
    { "path": "../walioffice-dsh-tool-chart" },
    { "path": "../walioffice-dsh-tool-drawio" },
    { "path": "../walioffice-dsh-tool-image" },
    { "path": "../walioffice-dsh-tool-video" }
  ]
}
